{
  "manifest_version": 3,
  "name": "小伐郵件高手",
  "description": "從 Excel 或 Google 試算表匯入稱謂、姓名、Email，一人一封專屬郵件，用自己的 Gmail 寄出。",
  "version": "1.7.0",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "小伐郵件高手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*"
  ]
}
