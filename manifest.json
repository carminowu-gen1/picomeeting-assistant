{
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "name": "小伐速記 PicoNotes",
  "description": "會議摘要助理：開會時自動記錄逐字稿，會後 AI 整理摘要、重點與待辦，一鍵匯出 Word。",
  "version": "1.3.1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "小伐速記"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "identity",
    "sidePanel",
    "tabCapture",
    "offscreen"
  ],
  "side_panel": {
    "default_path": "live/live.html"
  },
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/*",
    "https://meet.jit.si/*",
    "https://*.jitsi.net/*",
    "https://api.groq.com/*",
    "https://docs.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*",
        "https://meet.jit.si/*",
        "https://*.jitsi.net/*"
      ],
      "js": [
        "content/capture.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}